<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Twittter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Mantine stylesheet -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mantine/core@7.3.2/styles.css" />
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload", href: asset_path("application.css") %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if flash[:notice] %>
      <div style="padding: 1rem; background-color: #e6fcf5; margin-bottom: 1rem; border-radius: 4px;">
        <p class="notice"><%= notice %></p>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div style="padding: 1rem; background-color: #fff5f5; margin-bottom: 1rem; border-radius: 4px;">
        <p class="alert"><%= alert %></p>
      </div>
    <% end %>
    
    <%= yield %>
  </body>
</html>
